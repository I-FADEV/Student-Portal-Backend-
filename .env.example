NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/ifatoss?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_URL=http://localhost:5173
# Local development storage. On Render, configure Cloudinary or use an attached persistent disk.
UPLOAD_DIR=./uploads
# Preferred for Render without a persistent disk. Keep all credentials server-side.
# Use either CLOUDINARY_URL or all three CLOUD_NAME, CLOUD_API_KEY and CLOUD_API_SECRET.
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
# Set only when running npm run seed. Never use a shared/default password.
SEED_ADMIN_USERNAME=ga
SEED_ADMIN_PASSWORD=

# Optional web push: set all three on the backend only. Generate once with node scripts/generate-push-keys.cjs.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
